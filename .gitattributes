mvnw text eol=lf
*.cmd text eol=crlf
*.sh text eol=lf
# var_export 原样输出的测试夹具（行尾空格、字符串内的 CRLF 都是被测内容）：不做换行转换、不做空白检查
src/test/resources/legacyconfig/cases/*.php -text -whitespace
# 后台模板原样转写旧后台 HTML，输出字节与 PHP 黄金逐项比对：工作区里也必须是 LF（Windows 的 autocrlf 会改成 CRLF，页面多出 \r）
src/main/jte-admin/** text eol=lf
# 安装向导表结构指纹按字节随 jar 发布（B22）：工作区里也固定 LF，autocrlf 检出打出的 jar 才不带 \r
src/main/resources/install/schema-fingerprint.txt text eol=lf
# APPK-2 S3-01 官方模板包按字节入库（DEC-1）：验收用 git blob / 目录树 SHA 与官方提交逐字节比对，autocrlf 不得改写，也不做空白检查
third_party/maccms-template-v2020.1000.1035/** -text -whitespace
# APPK-2 S3-05：PHP 模板黄金（C-33）要与 PHP 7.3 的实际输出逐字节比对，输出里的 \r、行尾空格、
# BOM 都是被测内容。工作区里也必须保持生成时的原样，autocrlf 不能介入。
src/test/resources/phptemplate/** -text -whitespace
src/test/php/tpl_runtime_golden.php text eol=lf
src/test/php/tpl_art_fixture.php text eol=lf

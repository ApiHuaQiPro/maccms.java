# 接口自动化凭据（只列变量名，值由人工配置在运行时环境变量或已 gitignore 的 .env）
# 登记位置：产品仓 MULTICA.md §5

# 后台管理员会话令牌（默认角色，拥有目标 x-permission）
APP_API_TOKEN=

# 只读 / 低权限角色（无目标 x-permission 的管理员）：用于 200 无权限体断言
APP_API_TOKEN_READONLY=

# 与默认角色同级的另一个管理员：用于安装令牌/会话隔离的对照
APP_API_TOKEN_OTHER=

# 后台会话注入方式（二选一，都留空时脚本按 Authorization: Bearer 注入）
# 头名，例如 X-Auth-Token
ADMIN_AUTH_HEADER=
# 会话 cookie 名，例如 MACCMS_ADMIN_SESSION
ADMIN_SESSION_COOKIE=

# 后台入口前缀（配置 maccms.admin.entry），可用 --admin-entry 覆盖
MACCMS_ADMIN_ENTRY=/admin.php

    <delete id="deleteCjNodes">
        DELETE FROM mac_cj_node WHERE nodeid IN
        <foreach collection="ids" item="x" open="(" separator="," close=")">#{x}</foreach>
    </delete>

    <delete id="deleteCjHistories">
        DELETE FROM mac_cj_history WHERE md5 IN
        <foreach collection="ids" item="x" open="(" separator="," close=")">#{x}</foreach>
    </delete>

    <delete id="deleteCjContentsOfNodes">
        DELETE FROM mac_cj_content WHERE nodeid IN
        <foreach collection="ids" item="x" open="(" separator="," close=")">#{x}</foreach>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- B17 采集配置管理的写入（25 文档第 6 节；WriteRegistry 登记 collect 的 mac_collect、mac_cj_node 增删改与 mac_cj_content、mac_cj_history 删除）。 -->
<mapper namespace="com.maccms.backend.collect.infrastructure.CollectAdminWriteMapper">

    <!-- mac_collect：新增与按主键整行覆盖（旧 Collect::saveData，只写参数里有的列；列清单与 install.sql 相同，AdminTableSchemaTest 锁定） -->
    <insert id="insertCollect" useGeneratedKeys="true" keyProperty="id" keyColumn="collect_id">
        INSERT INTO mac_collect (<trim suffixOverrides=",">
            <if test="c.containsKey('collect_id')">collect_id,</if>
            <if test="c.containsKey('collect_name')">collect_name,</if>
            <if test="c.containsKey('collect_url')">collect_url,</if>
            <if test="c.containsKey('collect_type')">collect_type,</if>
            <if test="c.containsKey('collect_mid')">collect_mid,</if>
            <if test="c.containsKey('collect_appid')">collect_appid,</if>
            <if test="c.containsKey('collect_appkey')">collect_appkey,</if>
            <if test="c.containsKey('collect_param')">collect_param,</if>
            <if test="c.containsKey('collect_filter')">collect_filter,</if>
            <if test="c.containsKey('collect_filter_from')">collect_filter_from,</if>
            <if test="c.containsKey('collect_opt')">collect_opt,</if>
            <if test="c.containsKey('collect_sync_pic_opt')">collect_sync_pic_opt,</if>
        </trim>) VALUES (<trim suffixOverrides=",">
            <if test="c.containsKey('collect_id')">#{c.collect_id},</if>
            <if test="c.containsKey('collect_name')">#{c.collect_name},</if>
            <if test="c.containsKey('collect_url')">#{c.collect_url},</if>
            <if test="c.containsKey('collect_type')">#{c.collect_type},</if>
            <if test="c.containsKey('collect_mid')">#{c.collect_mid},</if>
            <if test="c.containsKey('collect_appid')">#{c.collect_appid},</if>
            <if test="c.containsKey('collect_appkey')">#{c.collect_appkey},</if>
            <if test="c.containsKey('collect_param')">#{c.collect_param},</if>
            <if test="c.containsKey('collect_filter')">#{c.collect_filter},</if>
            <if test="c.containsKey('collect_filter_from')">#{c.collect_filter_from},</if>
            <if test="c.containsKey('collect_opt')">#{c.collect_opt},</if>
            <if test="c.containsKey('collect_sync_pic_opt')">#{c.collect_sync_pic_opt},</if>
        </trim>)
    </insert>

    <update id="updateCollect">
        UPDATE mac_collect SET <trim suffixOverrides=",">
            <if test="c.containsKey('collect_id')">collect_id = #{c.collect_id},</if>
            <if test="c.containsKey('collect_name')">collect_name = #{c.collect_name},</if>
            <if test="c.containsKey('collect_url')">collect_url = #{c.collect_url},</if>
            <if test="c.containsKey('collect_type')">collect_type = #{c.collect_type},</if>
            <if test="c.containsKey('collect_mid')">collect_mid = #{c.collect_mid},</if>
            <if test="c.containsKey('collect_appid')">collect_appid = #{c.collect_appid},</if>
            <if test="c.containsKey('collect_appkey')">collect_appkey = #{c.collect_appkey},</if>
            <if test="c.containsKey('collect_param')">collect_param = #{c.collect_param},</if>
            <if test="c.containsKey('collect_filter')">collect_filter = #{c.collect_filter},</if>
            <if test="c.containsKey('collect_filter_from')">collect_filter_from = #{c.collect_filter_from},</if>
            <if test="c.containsKey('collect_opt')">collect_opt = #{c.collect_opt},</if>
            <if test="c.containsKey('collect_sync_pic_opt')">collect_sync_pic_opt = #{c.collect_sync_pic_opt},</if>
        </trim>
        WHERE collect_id = #{id}
    </update>

    <!-- 旧 Collect::delData：where collect_id in ids -->
    <delete id="deleteCollects">
        DELETE FROM mac_collect WHERE collect_id IN
        <foreach collection="ids" item="x" open="(" separator="," close=")">#{x}</foreach>
    </delete>


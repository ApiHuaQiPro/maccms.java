            <if test="c.containsKey('comment_reply')">comment_reply,</if>
            <if test="c.containsKey('comment_report')">comment_report,</if>
        </trim>) VALUES (<trim suffixOverrides=",">
            <if test="c.containsKey('comment_id')">#{c.comment_id},</if>
            <if test="c.containsKey('comment_mid')">#{c.comment_mid},</if>
            <if test="c.containsKey('comment_rid')">#{c.comment_rid},</if>
            <if test="c.containsKey('comment_pid')">#{c.comment_pid},</if>
            <if test="c.containsKey('user_id')">#{c.user_id},</if>

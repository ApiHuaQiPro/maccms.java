            <if test="c.containsKey('comment_report')">comment_report = #{c.comment_report},</if>
        </trim>
        WHERE comment_id IN <foreach collection="ids" item="i" open="(" separator="," close=")">#{i}</foreach>
    </update>

    <delete id="deleteCommentByIds">
        DELETE FROM mac_comment WHERE comment_id IN <foreach collection="ids" item="i" open="(" separator="," close=")">#{i}</foreach>
    </delete>


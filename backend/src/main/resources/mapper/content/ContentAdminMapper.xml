            <if test="c.pic == 3">AND website_pic LIKE '%#err%'</if>
            <if test="c.wdLike != null">AND website_name LIKE #{c.wdLike} ESCAPE '!'</if>
            <if test="c.repeat">AND website_name IN (SELECT n.website_name FROM (SELECT website_name FROM mac_website GROUP BY website_name HAVING COUNT(website_name) &gt; 1) n)</if>
        </where>
    </sql>


    <!-- ================================================================== 视频（旧 admin/controller/Vod.php、common/model/Vod.php） -->
    <!--
      列表与批量处理的条件：type 在列表页是 type_id|type_id_1，在批量页是 type_id；url=1 为播放地址为空；points 为播放或下载积分大于 0；
      关键字在列表页匹配名称、主演、副标题，在批量页只匹配名称（wdNameOnly）；播放器/下载器 no 为空或 no；服务器组匹配播放或下载服务器
    -->
    <sql id="vodCondition">
        <where>
            <if test="c.typeEither != null">AND (type_id = #{c.typeEither} OR type_id_1 = #{c.typeEither})</if>
            <if test="c.typeExact != null">AND type_id = #{c.typeExact}</if>
            <if test="c.level != null">AND vod_level = #{c.level}</if>
            <if test="c.status != null">AND vod_status = #{c.status}</if>
            <if test="c.copyright != null">AND vod_copyright = #{c.copyright}</if>
            <if test="c.isend != null">AND vod_isend = #{c.isend}</if>
            <if test="c.lock != null">AND vod_lock = #{c.lock}</if>
            <if test="c.state != null">AND vod_state = #{c.state}</if>
            <if test="c.area != null">AND vod_area = #{c.area}</if>
            <if test="c.lang != null">AND vod_lang = #{c.lang}</if>
            <if test="c.plot != null">AND vod_plot = #{c.plot}</if>
            <if test="c.urlEmpty">AND vod_play_url = ''</if>
            <if test="c.points">AND (vod_points_play &gt; 0 OR vod_points_down &gt; 0)</if>
            <if test="c.pic == 1">AND vod_pic = ''</if>
            <if test="c.pic == 2">AND vod_pic LIKE 'http%'</if>
            <if test="c.pic == 3">AND vod_pic LIKE '%#err%'</if>
            <if test="c.weekdayLike != null">AND vod_weekday LIKE #{c.weekdayLike} ESCAPE '!'</if>
            <if test="c.wdLike != null and c.wdNameOnly">AND vod_name LIKE #{c.wdLike} ESCAPE '!'</if>
            <if test="c.wdLike != null and !c.wdNameOnly">AND (vod_name LIKE #{c.wdLike} ESCAPE '!' OR vod_actor LIKE #{c.wdLike} ESCAPE '!' OR vod_sub LIKE #{c.wdLike} ESCAPE '!')</if>
            <if test="c.playerNo">AND (vod_play_from = '' OR vod_play_from = 'no')</if>
            <if test="c.playerLike != null">AND vod_play_from LIKE #{c.playerLike} ESCAPE '!'</if>
            <if test="c.downerNo">AND (vod_down_from = '' OR vod_down_from = 'no')</if>
            <if test="c.downerLike != null">AND vod_down_from LIKE #{c.downerLike} ESCAPE '!'</if>
            <if test="c.serverLike != null">AND (vod_play_server LIKE #{c.serverLike} ESCAPE '!' OR vod_down_server LIKE #{c.serverLike} ESCAPE '!')</if>
            <if test="c.repeat">AND vod_name IN (SELECT n.vod_name FROM (SELECT vod_name FROM mac_vod GROUP BY vod_name HAVING COUNT(vod_name) &gt; 1) n)</if>
        </where>
    </sql>

    <select id="countVods" resultType="long">
        SELECT COUNT(*) FROM mac_vod <include refid="vodCondition"/>
    </select>

    <!-- 旧 order：列表 vod_time desc 或白名单里的列 desc、查重 vod_name asc、批量 vod_id desc；同序时按 vod_id 升序（旧版由 MySQL 决定，MyISAM 上通常是写入顺序） -->
    <select id="listVods" resultMap="vodRow">
        SELECT <include refid="vodColumns"/> FROM mac_vod <include refid="vodCondition"/>
        <choose>
            <when test="c.repeat">ORDER BY vod_name ASC, vod_id ASC</when>
            <when test="c.order == 'id_desc'">ORDER BY vod_id DESC</when>
            <when test="c.order == 'vod_id'">ORDER BY vod_id DESC</when>
            <when test="c.order == 'vod_hits'">ORDER BY vod_hits DESC, vod_id ASC</when>
            <when test="c.order == 'vod_hits_month'">ORDER BY vod_hits_month DESC, vod_id ASC</when>
            <when test="c.order == 'vod_hits_week'">ORDER BY vod_hits_week DESC, vod_id ASC</when>
            <when test="c.order == 'vod_hits_day'">ORDER BY vod_hits_day DESC, vod_id ASC</when>
            <otherwise>ORDER BY vod_time DESC, vod_id ASC</otherwise>
        </choose>
        LIMIT #{offset}, #{limit}
    </select>

    <select id="vodRepeatGroups" resultType="map">
        SELECT MIN(vod_id) AS id, vod_name AS name FROM mac_vod GROUP BY vod_name HAVING COUNT(vod_name) &gt; 1
        ORDER BY id LIMIT #{offset}, #{limit}
    </select>

    <select id="vodToday" resultType="long">
        SELECT <choose><when test="type">type_id</when><otherwise>vod_id</otherwise></choose>
        FROM mac_vod WHERE vod_time &gt; #{since} ORDER BY vod_id
    </select>

    <select id="selectVodsByIds" resultMap="vodRow">
        SELECT <include refid="vodColumns"/> FROM mac_vod WHERE vod_id IN <foreach collection="ids" item="i" open="(" separator="," close=")">#{i}</foreach> ORDER BY vod_id
    </select>
</mapper>

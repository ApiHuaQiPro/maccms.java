<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  只读映射：沿用旧表 mac_vod（install.sql:685）。禁止在此文件加入写语句，禁止 ${} 拼接。
  不查询的列（不得出现在任何 select 中）：vod_pwd 及 vod_pwd_*（只以 CHAR_LENGTH(vod_pwd) > 0 的布尔结果出现；比 PHP 的 !empty 更严：值为 "0" 也视为有密码）、
  vod_play_* / vod_down_*（播放与下载地址）、vod_points*、vod_trysee、group_id、vod_lock、vod_tpl*、
  vod_reurl、vod_jumpurl、vod_author、vod_time_make、vod_time_hits、vod_rel_*、vod_plot*、vod_pic_screenshot。
  例外（B05）：legacyConditions 片段把 vod_rel_vod、vod_plot、vod_time_hits 只用作 WHERE 条件（旧模板标签的 rel、plot、timehits），
  从不出现在 select 列中（ReadOnlyGuardrailsTest 检查）。
-->
<mapper namespace="com.maccms.backend.content.infrastructure.VodMapper">

    <sql id="publishedInTypes">
        vod_status = 1
        AND type_id IN
        <foreach collection="typeIds" item="tid" open="(" separator="," close=")">#{tid}</foreach>
    </sql>

    <!--
      搜索/筛选条件（契约 1.1.0，docs/architecture/09-content-search-filter-plan.md 第 4、6.1 节），只追加在 publishedInTypes 之后，
      只能在可见范围内收窄。列名固定，值只经 #{} 绑定；LIKE 模式由 content.application 构造并以 '!' 转义 %、_、!，
      反斜线按普通字符（不受 NO_BACKSLASH_ESCAPES 影响）。旧规则：level/year/area/lang 见 application/common/model/Vod.php:290-304
      （旧版逗号多值、year 整数比较；新版这里是单值形式、字符串比较，1.3.0 的多值形式见下）；wd 见 :462-468（vod_name 加 search_vod_rule 列，仓库值 vod_en|vod_sub，
      application/extra/maccms.php:70）；class 见 :475-477。
    -->
    <sql id="matchingConditions">
        <if test="filter.level != null">AND vod_level = #{filter.level}</if>
        <if test="filter.year != null">AND vod_year = #{filter.year}</if>
        <if test="filter.area != null">AND vod_area = #{filter.area}</if>
        <if test="filter.lang != null">AND vod_lang = #{filter.lang}</if>
        <if test="filter.classesPattern != null">AND vod_class LIKE #{filter.classesPattern} ESCAPE '!'</if>
        <if test="filter.keywordPatterns != null">
            AND (<foreach collection="filter.keywordPatterns" item="p" separator=" OR ">vod_name LIKE #{p} ESCAPE '!' OR vod_sub LIKE #{p} ESCAPE '!' OR vod_en LIKE #{p} ESCAPE '!'</foreach>)
        </if>
        <!--
          契约 1.3.0（B04，docs/architecture/14-video-list-filter-completion.md 第 3 节），追加在 1.1.0 条件之后（不传时上面的 SQL 文本不变）。
          旧规则：year 区间 application/common/model/Vod.php:187-200,296-298（新版字符串比较）；letter :330-335；state/version :305-310；
          actor/director/tag/name :469-483（mac_like_arr，application/common.php:1284-1292，逗号拆分后各项 OR）；ids :273-277；
          随机排序候选段 :508-526（与 ids 同时出现时两者都要满足）。多值的各项、LIKE 模式由 content.application 构造。
          area/lang/class 的逗号多值 :299-304（IN explode）、:475-477（mac_like_arr）；只有一项时仍用上面 1.1.0 的单值形式。
        -->
        <if test="filter.areas != null">AND vod_area IN <foreach collection="filter.areas" item="v" open="(" separator="," close=")">#{v}</foreach></if>
        <if test="filter.langs != null">AND vod_lang IN <foreach collection="filter.langs" item="v" open="(" separator="," close=")">#{v}</foreach></if>
        <if test="filter.classesPatterns != null">AND (<foreach collection="filter.classesPatterns" item="p" separator=" OR ">vod_class LIKE #{p} ESCAPE '!'</foreach>)</if>
        <if test="filter.years != null">AND vod_year IN <foreach collection="filter.years" item="y" open="(" separator="," close=")">#{y}</foreach></if>
        <if test="filter.letters != null">AND vod_letter IN <foreach collection="filter.letters" item="v" open="(" separator="," close=")">#{v}</foreach></if>
        <if test="filter.states != null">AND vod_state IN <foreach collection="filter.states" item="v" open="(" separator="," close=")">#{v}</foreach></if>
        <if test="filter.versions != null">AND vod_version IN <foreach collection="filter.versions" item="v" open="(" separator="," close=")">#{v}</foreach></if>
        <if test="filter.actorPatterns != null">AND (<foreach collection="filter.actorPatterns" item="p" separator=" OR ">vod_actor LIKE #{p} ESCAPE '!'</foreach>)</if>
        <if test="filter.directorPatterns != null">AND (<foreach collection="filter.directorPatterns" item="p" separator=" OR ">vod_director LIKE #{p} ESCAPE '!'</foreach>)</if>
        <if test="filter.tagPatterns != null">AND (<foreach collection="filter.tagPatterns" item="p" separator=" OR ">vod_tag LIKE #{p} ESCAPE '!'</foreach>)</if>
        <if test="filter.namePatterns != null">AND (<foreach collection="filter.namePatterns" item="p" separator=" OR ">vod_name LIKE #{p} ESCAPE '!'</foreach>)</if>
        <if test="filter.ids != null">AND vod_id IN <foreach collection="filter.ids" item="id" open="(" separator="," close=")">#{id}</foreach></if>
        <if test="filter.candidateIds != null">AND vod_id IN <foreach collection="filter.candidateIds" item="id" open="(" separator="," close=")">#{id}</foreach></if>
        <if test="filter.legacy != null"><include refid="legacyConditions"/></if>
    </sql>

    <!--
      B05（docs/architecture/15-b05-readonly-pages.md 第 2 节）：旧模板标签专属条件与 SSR 的 tid，只由 site 经 content.application 构造，
      公开 API 从不设置。旧规则：tid application/common/model/Vod.php:180-182,356-358（type_id|type_id_1 = intval）；not :278-280；
      rel 非数字 :281-288（mac_like_arr）；level 多值/all :285-290；weekday :311-314；tv :315-317；timeadd/timehits/time :318-329
      （intval(strtotime()) 后 gt，时间点由调用方给出）；hitsmonth/hitsweek/hitsday/hits :363-394（运算符白名单，值整数）；
      isend :396-398；plot :484-486。旧版 not 与数字 rel 写入同一个 vod_id 键（后者覆盖前者、二者覆盖 ids），覆盖关系由
      content.application 在构造时处理，这里只按给定的绑定值生成条件。运算符由下面的 choose 写死，值只经 #{} 绑定。
    -->
    <sql id="legacyConditions">
        <if test="filter.legacy.tid != null">AND (type_id = #{filter.legacy.tid} OR type_id_1 = #{filter.legacy.tid})</if>
        <if test="filter.legacy.idsNotIn != null">AND vod_id NOT IN <foreach collection="filter.legacy.idsNotIn" item="id" open="(" separator="," close=")">#{id}</foreach></if>
        <if test="filter.legacy.relPatterns != null">AND (<foreach collection="filter.legacy.relPatterns" item="p" separator=" OR ">vod_rel_vod LIKE #{p} ESCAPE '!'</foreach>)</if>
        <if test="filter.legacy.levels != null">AND vod_level IN <foreach collection="filter.legacy.levels" item="v" open="(" separator="," close=")">#{v}</foreach></if>
        <if test="filter.legacy.weekdayPatterns != null">AND (<foreach collection="filter.legacy.weekdayPatterns" item="p" separator=" OR ">vod_weekday LIKE #{p} ESCAPE '!'</foreach>)</if>
        <if test="filter.legacy.tvs != null">AND vod_tv IN <foreach collection="filter.legacy.tvs" item="v" open="(" separator="," close=")">#{v}</foreach></if>
        <if test="filter.legacy.addedAfter != null">AND vod_time_add &gt; #{filter.legacy.addedAfter}</if>
        <if test="filter.legacy.hitsTimeAfter != null">AND vod_time_hits &gt; #{filter.legacy.hitsTimeAfter}</if>
        <if test="filter.legacy.updatedAfter != null">AND vod_time &gt; #{filter.legacy.updatedAfter}</if>
        <if test="filter.legacy.hitsMonth != null">
            <choose>
                <when test="filter.legacy.hitsMonth.op == 'EQ'">AND vod_hits_month = #{filter.legacy.hitsMonth.value}</when>
                <when test="filter.legacy.hitsMonth.op == 'NEQ'">AND vod_hits_month &lt;&gt; #{filter.legacy.hitsMonth.value}</when>
                <when test="filter.legacy.hitsMonth.op == 'GT'">AND vod_hits_month &gt; #{filter.legacy.hitsMonth.value}</when>
                <when test="filter.legacy.hitsMonth.op == 'EGT'">AND vod_hits_month &gt;= #{filter.legacy.hitsMonth.value}</when>
                <when test="filter.legacy.hitsMonth.op == 'LT'">AND vod_hits_month &lt; #{filter.legacy.hitsMonth.value}</when>
                <when test="filter.legacy.hitsMonth.op == 'ELT'">AND vod_hits_month &lt;= #{filter.legacy.hitsMonth.value}</when>
                <when test="filter.legacy.hitsMonth.op == 'BETWEEN'">AND vod_hits_month BETWEEN #{filter.legacy.hitsMonth.low} AND #{filter.legacy.hitsMonth.high}</when>
                <when test="filter.legacy.hitsMonth.op == 'NOT_BETWEEN'">AND vod_hits_month NOT BETWEEN #{filter.legacy.hitsMonth.low} AND #{filter.legacy.hitsMonth.high}</when>
                <when test="filter.legacy.hitsMonth.op == 'IN'">AND vod_hits_month IN <foreach collection="filter.legacy.hitsMonth.values" item="v" open="(" separator="," close=")">#{v}</foreach></when>
                <otherwise>AND vod_hits_month NOT IN <foreach collection="filter.legacy.hitsMonth.values" item="v" open="(" separator="," close=")">#{v}</foreach></otherwise>
            </choose>
        </if>
        <if test="filter.legacy.hitsWeek != null">
            <choose>
                <when test="filter.legacy.hitsWeek.op == 'EQ'">AND vod_hits_week = #{filter.legacy.hitsWeek.value}</when>
                <when test="filter.legacy.hitsWeek.op == 'NEQ'">AND vod_hits_week &lt;&gt; #{filter.legacy.hitsWeek.value}</when>
                <when test="filter.legacy.hitsWeek.op == 'GT'">AND vod_hits_week &gt; #{filter.legacy.hitsWeek.value}</when>
                <when test="filter.legacy.hitsWeek.op == 'EGT'">AND vod_hits_week &gt;= #{filter.legacy.hitsWeek.value}</when>
                <when test="filter.legacy.hitsWeek.op == 'LT'">AND vod_hits_week &lt; #{filter.legacy.hitsWeek.value}</when>
                <when test="filter.legacy.hitsWeek.op == 'ELT'">AND vod_hits_week &lt;= #{filter.legacy.hitsWeek.value}</when>
                <when test="filter.legacy.hitsWeek.op == 'BETWEEN'">AND vod_hits_week BETWEEN #{filter.legacy.hitsWeek.low} AND #{filter.legacy.hitsWeek.high}</when>
                <when test="filter.legacy.hitsWeek.op == 'NOT_BETWEEN'">AND vod_hits_week NOT BETWEEN #{filter.legacy.hitsWeek.low} AND #{filter.legacy.hitsWeek.high}</when>
                <when test="filter.legacy.hitsWeek.op == 'IN'">AND vod_hits_week IN <foreach collection="filter.legacy.hitsWeek.values" item="v" open="(" separator="," close=")">#{v}</foreach></when>
                <otherwise>AND vod_hits_week NOT IN <foreach collection="filter.legacy.hitsWeek.values" item="v" open="(" separator="," close=")">#{v}</foreach></otherwise>
            </choose>
        </if>
        <if test="filter.legacy.hitsDay != null">
            <choose>
                <when test="filter.legacy.hitsDay.op == 'EQ'">AND vod_hits_day = #{filter.legacy.hitsDay.value}</when>
                <when test="filter.legacy.hitsDay.op == 'NEQ'">AND vod_hits_day &lt;&gt; #{filter.legacy.hitsDay.value}</when>
                <when test="filter.legacy.hitsDay.op == 'GT'">AND vod_hits_day &gt; #{filter.legacy.hitsDay.value}</when>
                <when test="filter.legacy.hitsDay.op == 'EGT'">AND vod_hits_day &gt;= #{filter.legacy.hitsDay.value}</when>
                <when test="filter.legacy.hitsDay.op == 'LT'">AND vod_hits_day &lt; #{filter.legacy.hitsDay.value}</when>
                <when test="filter.legacy.hitsDay.op == 'ELT'">AND vod_hits_day &lt;= #{filter.legacy.hitsDay.value}</when>
                <when test="filter.legacy.hitsDay.op == 'BETWEEN'">AND vod_hits_day BETWEEN #{filter.legacy.hitsDay.low} AND #{filter.legacy.hitsDay.high}</when>
                <when test="filter.legacy.hitsDay.op == 'NOT_BETWEEN'">AND vod_hits_day NOT BETWEEN #{filter.legacy.hitsDay.low} AND #{filter.legacy.hitsDay.high}</when>
                <when test="filter.legacy.hitsDay.op == 'IN'">AND vod_hits_day IN <foreach collection="filter.legacy.hitsDay.values" item="v" open="(" separator="," close=")">#{v}</foreach></when>
                <otherwise>AND vod_hits_day NOT IN <foreach collection="filter.legacy.hitsDay.values" item="v" open="(" separator="," close=")">#{v}</foreach></otherwise>
            </choose>
        </if>
        <if test="filter.legacy.hits != null">
            <choose>
                <when test="filter.legacy.hits.op == 'EQ'">AND vod_hits = #{filter.legacy.hits.value}</when>
                <when test="filter.legacy.hits.op == 'NEQ'">AND vod_hits &lt;&gt; #{filter.legacy.hits.value}</when>
                <when test="filter.legacy.hits.op == 'GT'">AND vod_hits &gt; #{filter.legacy.hits.value}</when>
                <when test="filter.legacy.hits.op == 'EGT'">AND vod_hits &gt;= #{filter.legacy.hits.value}</when>
                <when test="filter.legacy.hits.op == 'LT'">AND vod_hits &lt; #{filter.legacy.hits.value}</when>
                <when test="filter.legacy.hits.op == 'ELT'">AND vod_hits &lt;= #{filter.legacy.hits.value}</when>
                <when test="filter.legacy.hits.op == 'BETWEEN'">AND vod_hits BETWEEN #{filter.legacy.hits.low} AND #{filter.legacy.hits.high}</when>
                <when test="filter.legacy.hits.op == 'NOT_BETWEEN'">AND vod_hits NOT BETWEEN #{filter.legacy.hits.low} AND #{filter.legacy.hits.high}</when>
                <when test="filter.legacy.hits.op == 'IN'">AND vod_hits IN <foreach collection="filter.legacy.hits.values" item="v" open="(" separator="," close=")">#{v}</foreach></when>
                <otherwise>AND vod_hits NOT IN <foreach collection="filter.legacy.hits.values" item="v" open="(" separator="," close=")">#{v}</foreach></otherwise>
            </choose>
        </if>
        <if test="filter.legacy.isEnd != null">AND vod_isend = #{filter.legacy.isEnd}</if>
        <if test="filter.legacy.plot != null">AND vod_plot = #{filter.legacy.plot}</if>
    </sql>

    <sql id="summaryColumns">
        vod_id                   AS id,
        type_id                  AS categoryId,
        vod_name                 AS name,
        vod_sub                  AS subTitle,
        vod_en                   AS enName,
        vod_letter               AS letter,
        vod_color                AS color,
        vod_class                AS classes,
        vod_tag                  AS tag,
        vod_pic                  AS pic,
        vod_pic_thumb            AS picThumb,
        vod_pic_slide            AS picSlide,
        vod_actor                AS actor,
        vod_director             AS director,
        vod_blurb                AS blurb,
        vod_remarks              AS remarks,
        vod_area                 AS area,
        vod_lang                 AS lang,
        vod_year                 AS year,
        vod_version              AS version,
        vod_state                AS state,
        vod_serial               AS serial,
        vod_total                AS total,
        vod_isend                AS isEnd,
        vod_level                AS level,
        vod_copyright            AS copyright,
        vod_score                AS score,
        vod_score_num            AS scoreNum,
        vod_hits                 AS hits,
        vod_hits_day             AS hitsDay,
        vod_hits_week            AS hitsWeek,
        vod_hits_month           AS hitsMonth,
        vod_up                   AS up,
        vod_down                 AS down,
        vod_time                 AS updatedAt,
        vod_time_add             AS addedAt,
        (CHAR_LENGTH(vod_pwd) &gt; 0) AS detailPasswordRequired
    </sql>

    <select id="countPublished" resultType="long">
        SELECT COUNT(*)
        FROM mac_vod
        WHERE <include refid="publishedInTypes"/>
    </select>

    <!--
      带搜索/筛选条件的 count 与分页共用 publishedInTypes + matchingConditions，保证 total 与列表条件一致。
      MAX_EXECUTION_TIME(3000) 是服务端执行时限（MySQL 5.7.8+ 对 SELECT 生效，超时报 3024，ContentReadService 归为 503）；
      字面常量，不经参数。MyBatis 全局 10 秒 JDBC 超时仍作兜底。
    -->
    <select id="countPublishedMatching" resultType="long">
        SELECT /*+ MAX_EXECUTION_TIME(3000) */ COUNT(*)
        FROM mac_vod
        WHERE <include refid="publishedInTypes"/>
        <include refid="matchingConditions"/>
    </select>

    <select id="selectPublishedPage" resultType="com.maccms.backend.content.infrastructure.VodSummaryRow">
        SELECT <include refid="summaryColumns"/>
        FROM mac_vod
        WHERE <include refid="publishedInTypes"/>
        <include refid="pageOrderAndLimit"/>
    </select>

    <select id="selectPublishedMatchingPage" resultType="com.maccms.backend.content.infrastructure.VodSummaryRow">
        SELECT /*+ MAX_EXECUTION_TIME(3000) */ <include refid="summaryColumns"/>
        FROM mac_vod
        WHERE <include refid="publishedInTypes"/>
        <include refid="matchingConditions"/>
        <include refid="pageOrderAndLimit"/>
    </select>

    <!--
      排序白名单对应旧 Vod::listCacheData 的 by 取值（common/model/Vod.php:539）；rnd 不是排序列，由 ContentReadService 按旧算法
      选页或加候选 ID 段后以 HITS_WEEK DESC 调用这里（1.3.0）；
      追加 vod_id 同向排序保证分页稳定（带不带搜索/筛选条件都一样）。
    -->
    <sql id="pageOrderAndLimit">
        ORDER BY
        <choose>
            <when test="sort.name() == 'TIME'">vod_time</when>
            <when test="sort.name() == 'TIME_ADD'">vod_time_add</when>
            <when test="sort.name() == 'SCORE'">vod_score</when>
            <when test="sort.name() == 'HITS'">vod_hits</when>
            <when test="sort.name() == 'HITS_DAY'">vod_hits_day</when>
            <when test="sort.name() == 'HITS_WEEK'">vod_hits_week</when>
            <when test="sort.name() == 'HITS_MONTH'">vod_hits_month</when>
            <when test="sort.name() == 'UP'">vod_up</when>
            <when test="sort.name() == 'DOWN'">vod_down</when>
            <when test="sort.name() == 'LEVEL'">vod_level</when>
            <otherwise>vod_id</otherwise>
        </choose>
        <choose>
            <when test="descending">DESC, vod_id DESC</when>
            <otherwise>ASC, vod_id ASC</otherwise>
        </choose>
        LIMIT #{offset}, #{limit}
    </sql>

    <!--
      随机排序（契约 1.3.0 sort=rnd）的 ID 段：旧 Vod.php:509 的 MAX/MIN(vod_id)，不带任何条件（含未审核行，与旧版相同）。
      MyISAM 主键上的 MIN/MAX 由优化器直接取得（Select tables optimized away）；执行时限与其他搜索/筛选语句相同。
    -->
    <select id="selectIdRange" resultType="com.maccms.backend.content.infrastructure.VodIdRange">
        SELECT /*+ MAX_EXECUTION_TIME(3000) */ MIN(vod_id) AS minId, MAX(vod_id) AS maxId
        FROM mac_vod
    </select>

    <!-- 对应旧 mac_label_vod_detail 的 vod_id + vod_status=1 条件（application/common.php:2715-2728）。 -->
    <select id="selectPublishedDetail" resultType="com.maccms.backend.content.infrastructure.VodDetailRow">
        SELECT vod_id                   AS id,
               type_id                  AS categoryId,
               vod_name                 AS name,
               vod_sub                  AS subTitle,
               vod_en                   AS enName,
               vod_letter               AS letter,
               vod_color                AS color,
               vod_class                AS classes,
               vod_tag                  AS tag,
               vod_pic                  AS pic,
               vod_pic_thumb            AS picThumb,
               vod_pic_slide            AS picSlide,
               vod_actor                AS actor,
               vod_director             AS director,
               vod_writer               AS writer,
               vod_behind               AS behind,
               vod_blurb                AS blurb,
               vod_remarks              AS remarks,
               vod_pubdate              AS pubdate,
               vod_area                 AS area,
               vod_lang                 AS lang,
               vod_year                 AS year,
               vod_version              AS version,
               vod_state                AS state,
               vod_tv                   AS tv,
               vod_weekday              AS weekday,
               vod_duration             AS duration,
               vod_serial               AS serial,
               vod_total                AS total,
               vod_isend                AS isEnd,
               vod_level                AS level,
               vod_copyright            AS copyright,
               vod_score                AS score,
               vod_score_all            AS scoreAll,
               vod_score_num            AS scoreNum,
               vod_douban_id            AS doubanId,
               vod_douban_score         AS doubanScore,
               vod_hits                 AS hits,
               vod_hits_day             AS hitsDay,
               vod_hits_week            AS hitsWeek,
               vod_hits_month           AS hitsMonth,
               vod_up                   AS up,
               vod_down                 AS down,
               vod_time                 AS updatedAt,
               vod_time_add             AS addedAt,
               vod_content              AS content,
               (CHAR_LENGTH(vod_pwd) &gt; 0) AS detailPasswordRequired
        FROM mac_vod
        WHERE vod_id = #{id}
          AND vod_status = 1
    </select>

    <!--
      专题关联视频（MACC-27，application/common/model/Topic.php:291-301）：vod_id IN (topic_rel_vod) + vod_status=1，按 vod_time 倒序
      取前 999 条；新增分类可见性条件，追加 vod_id 倒序使并列时结果确定。
    -->
    <select id="selectPublishedByIds" resultType="com.maccms.backend.content.infrastructure.VodSummaryRow">
        SELECT /*+ MAX_EXECUTION_TIME(3000) */ <include refid="summaryColumns"/>
        FROM mac_vod
        WHERE <include refid="publishedInTypes"/>
          AND vod_id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY vod_time DESC, vod_id DESC
        LIMIT 999
    </select>

    <!-- 专题按标签关联视频（MACC-27，Topic.php:314-323）：vod_tag LIKE 任一模式（由 content.application 构造并以 '!' 转义）。 -->
    <select id="selectPublishedByTagPatterns" resultType="com.maccms.backend.content.infrastructure.VodSummaryRow">
        SELECT /*+ MAX_EXECUTION_TIME(3000) */ <include refid="summaryColumns"/>
        FROM mac_vod
        WHERE <include refid="publishedInTypes"/>
          AND (<foreach collection="patterns" item="p" separator=" OR ">vod_tag LIKE #{p} ESCAPE '!'</foreach>)
        ORDER BY vod_time DESC, vod_id DESC
        LIMIT 999
    </select>

    <!--
      角色所属视频（MACC-27）：旧 Role::listData/infoData 按 role_rid 取视频（application/common/model/Role.php:41-51、:296-303，
      不看 vod_status）；新版只取已审核的视频，分类可见性由 content.application 判定。
    -->
    <select id="selectPublishedRefs" resultType="com.maccms.backend.content.infrastructure.VodRefRow">
        SELECT vod_id   AS id,
               type_id  AS categoryId,
               vod_name AS name,
               vod_en   AS enName
        FROM mac_vod
        WHERE vod_status = 1
          AND vod_id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <!--
      播放/下载入口（B05，docs/architecture/15-b05-readonly-pages.md 第 6 节）：旧 label_vod_play 经 mac_label_vod_detail 取
      vod_status=1 的整行（application/common.php:2715-2733、common/controller/All.php:442-563）。新版只取授权判定与播放器所需的列；
      密码列只以布尔表达式出现：是否非空（CHAR_LENGTH，与详情的 detailPasswordRequired 相同，"0" 也算有密码，B03 已登记差异），
      以及凭据是否与当前密码一致（SHA2(CONCAT(salt, 密码列), 256) = hash；salt 与 hash 都是 64 位十六进制，由 content.application 校验）。
      down=false 取 vod_play_* 与 vod_points_play、vod_pwd_play；down=true 取 vod_down_* 与 vod_points_down、vod_pwd_down。
    -->
    <select id="selectPlayback" resultType="com.maccms.backend.content.infrastructure.VodPlaybackRow">
        SELECT vod_id                   AS id,
               type_id                  AS categoryId,
               vod_name                 AS name,
               vod_actor                AS actor,
               vod_director             AS director,
               vod_class                AS classes,
               vod_copyright            AS copyright,
               vod_trysee               AS trySee,
               vod_points               AS pointsWhole,
        <choose>
            <when test="down">
               vod_points_down          AS pointsKind,
               vod_down_from            AS sourceFrom,
               vod_down_url             AS sourceUrl,
               vod_down_server          AS sourceServer,
               vod_down_note            AS sourceNote,
               (CHAR_LENGTH(vod_pwd_down) &gt; 0) AS passwordRequired,
            </when>
            <otherwise>
               vod_points_play          AS pointsKind,
               vod_play_from            AS sourceFrom,
               vod_play_url             AS sourceUrl,
               vod_play_server          AS sourceServer,
               vod_play_note            AS sourceNote,
               (CHAR_LENGTH(vod_pwd_play) &gt; 0) AS passwordRequired,
            </otherwise>
        </choose>
        <choose>
            <when test="proofSalt != null and proofHash != null and down">
               (SHA2(CONCAT(#{proofSalt}, vod_pwd_down), 256) = #{proofHash}) AS passwordProven,
            </when>
            <when test="proofSalt != null and proofHash != null">
               (SHA2(CONCAT(#{proofSalt}, vod_pwd_play), 256) = #{proofHash}) AS passwordProven,
            </when>
            <otherwise>
               0                        AS passwordProven,
            </otherwise>
        </choose>
               vod_time                 AS updatedAt
        FROM mac_vod
        WHERE vod_id = #{id}
          AND vod_status = 1
    </select>

    <!--
      访问密码校验（B05，旧 ajax/pwd 的 1-4、1-5，application/index/controller/Ajax.php:421-442）：旧版按 id 取视频（不看 vod_status）后
      以 PHP != 宽松比较；新版只认已审核的视频，密码列非空且与输入逐字节相等（BINARY，不做 PHP 数字字符串的宽松相等），只返回 0/1。
    -->
    <select id="countPasswordMatch" resultType="int">
        SELECT COUNT(*)
        FROM mac_vod
        WHERE vod_id = #{id}
          AND vod_status = 1
        <choose>
            <when test="down">
          AND CHAR_LENGTH(vod_pwd_down) &gt; 0
          AND BINARY vod_pwd_down = BINARY #{candidate}
            </when>
            <otherwise>
          AND CHAR_LENGTH(vod_pwd_play) &gt; 0
          AND BINARY vod_pwd_play = BINARY #{candidate}
            </otherwise>
        </choose>
    </select>
</mapper>

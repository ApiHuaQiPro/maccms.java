<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  只读映射：沿用旧表 mac_vod（install.sql:685）。禁止在此文件加入写语句，禁止 ${} 拼接。
  不查询的列（不得出现在任何 select 中）：vod_pwd 及 vod_pwd_*（只以 CHAR_LENGTH(vod_pwd) > 0 的布尔结果出现；比 PHP 的 !empty 更严：值为 "0" 也视为有密码）、
  vod_play_* / vod_down_*（播放与下载地址）、vod_points*、vod_trysee、group_id、vod_lock、vod_tpl*、
  vod_reurl、vod_jumpurl、vod_author、vod_time_make、vod_time_hits、vod_rel_*、vod_plot*、vod_pic_screenshot。
-->
<mapper namespace="com.maccms.backend.content.infrastructure.VodMapper">

    <sql id="publishedInTypes">
        vod_status = 1
        AND type_id IN
        <foreach collection="typeIds" item="tid" open="(" separator="," close=")">#{tid}</foreach>
    </sql>

    <!--
      搜索/筛选条件（契约 1.1.0，docs/architecture/09-content-search-filter-plan.md 第 4、6.1 节），只追加在 publishedInTypes 之后，
      只能在可见范围内收窄。列名固定，值只经 #{} 绑定；LIKE 模式由 content.application 构造并以 '!' 转义 %、_、!，
      反斜线按普通字符（不受 NO_BACKSLASH_ESCAPES 影响）。旧规则：level/year/area/lang 见 application/common/model/Vod.php:290-304
      （旧版逗号多值、year 整数比较，新版单值、字符串比较）；wd 见 :462-468（vod_name 加 search_vod_rule 列，仓库值 vod_en|vod_sub，
      application/extra/maccms.php:70）；class 见 :475-477。
    -->
    <sql id="matchingConditions">
        <if test="filter.level != null">AND vod_level = #{filter.level}</if>
        <if test="filter.year != null">AND vod_year = #{filter.year}</if>
        <if test="filter.area != null">AND vod_area = #{filter.area}</if>
        <if test="filter.lang != null">AND vod_lang = #{filter.lang}</if>
        <if test="filter.classesPattern != null">AND vod_class LIKE #{filter.classesPattern} ESCAPE '!'</if>
        <if test="filter.keywordPatterns != null">
            AND (<foreach collection="filter.keywordPatterns" item="p" separator=" OR ">vod_name LIKE #{p} ESCAPE '!' OR vod_sub LIKE #{p} ESCAPE '!' OR vod_en LIKE #{p} ESCAPE '!'</foreach>)
        </if>
    </sql>

    <sql id="summaryColumns">
        vod_id                   AS id,
        type_id                  AS categoryId,
        vod_name                 AS name,
        vod_sub                  AS subTitle,
        vod_en                   AS enName,
        vod_letter               AS letter,
        vod_color                AS color,
        vod_class                AS classes,
        vod_tag                  AS tag,
        vod_pic                  AS pic,
        vod_pic_thumb            AS picThumb,
        vod_pic_slide            AS picSlide,
        vod_actor                AS actor,
        vod_director             AS director,
        vod_blurb                AS blurb,
        vod_remarks              AS remarks,
        vod_area                 AS area,
        vod_lang                 AS lang,
        vod_year                 AS year,
        vod_version              AS version,
        vod_state                AS state,
        vod_serial               AS serial,
        vod_total                AS total,
        vod_isend                AS isEnd,
        vod_level                AS level,
        vod_copyright            AS copyright,
        vod_score                AS score,
        vod_score_num            AS scoreNum,
        vod_hits                 AS hits,
        vod_hits_day             AS hitsDay,
        vod_hits_week            AS hitsWeek,
        vod_hits_month           AS hitsMonth,
        vod_up                   AS up,
        vod_down                 AS down,
        vod_time                 AS updatedAt,
        vod_time_add             AS addedAt,
        (CHAR_LENGTH(vod_pwd) &gt; 0) AS detailPasswordRequired
    </sql>

    <select id="countPublished" resultType="long">
        SELECT COUNT(*)
        FROM mac_vod
        WHERE <include refid="publishedInTypes"/>
    </select>

    <!--
      带搜索/筛选条件的 count 与分页共用 publishedInTypes + matchingConditions，保证 total 与列表条件一致。
      MAX_EXECUTION_TIME(3000) 是服务端执行时限（MySQL 5.7.8+ 对 SELECT 生效，超时报 3024，ContentReadService 归为 503）；
      字面常量，不经参数。MyBatis 全局 10 秒 JDBC 超时仍作兜底。
    -->
    <select id="countPublishedMatching" resultType="long">
        SELECT /*+ MAX_EXECUTION_TIME(3000) */ COUNT(*)
        FROM mac_vod
        WHERE <include refid="publishedInTypes"/>
        <include refid="matchingConditions"/>
    </select>

    <select id="selectPublishedPage" resultType="com.maccms.backend.content.infrastructure.VodSummaryRow">
        SELECT <include refid="summaryColumns"/>
        FROM mac_vod
        WHERE <include refid="publishedInTypes"/>
        <include refid="pageOrderAndLimit"/>
    </select>

    <select id="selectPublishedMatchingPage" resultType="com.maccms.backend.content.infrastructure.VodSummaryRow">
        SELECT /*+ MAX_EXECUTION_TIME(3000) */ <include refid="summaryColumns"/>
        FROM mac_vod
        WHERE <include refid="publishedInTypes"/>
        <include refid="matchingConditions"/>
        <include refid="pageOrderAndLimit"/>
    </select>

    <!--
      排序白名单对应旧 Vod::listCacheData 的 by 取值（common/model/Vod.php:539），rnd 暂不支持；
      追加 vod_id 同向排序保证分页稳定（带不带搜索/筛选条件都一样）。
    -->
    <sql id="pageOrderAndLimit">
        ORDER BY
        <choose>
            <when test="sort.name() == 'TIME'">vod_time</when>
            <when test="sort.name() == 'TIME_ADD'">vod_time_add</when>
            <when test="sort.name() == 'SCORE'">vod_score</when>
            <when test="sort.name() == 'HITS'">vod_hits</when>
            <when test="sort.name() == 'HITS_DAY'">vod_hits_day</when>
            <when test="sort.name() == 'HITS_WEEK'">vod_hits_week</when>
            <when test="sort.name() == 'HITS_MONTH'">vod_hits_month</when>
            <when test="sort.name() == 'UP'">vod_up</when>
            <when test="sort.name() == 'DOWN'">vod_down</when>
            <when test="sort.name() == 'LEVEL'">vod_level</when>
            <otherwise>vod_id</otherwise>
        </choose>
        <choose>
            <when test="descending">DESC, vod_id DESC</when>
            <otherwise>ASC, vod_id ASC</otherwise>
        </choose>
        LIMIT #{offset}, #{limit}
    </sql>

    <!-- 对应旧 mac_label_vod_detail 的 vod_id + vod_status=1 条件（application/common.php:2715-2728）。 -->
    <select id="selectPublishedDetail" resultType="com.maccms.backend.content.infrastructure.VodDetailRow">
        SELECT vod_id                   AS id,
               type_id                  AS categoryId,
               vod_name                 AS name,
               vod_sub                  AS subTitle,
               vod_en                   AS enName,
               vod_letter               AS letter,
               vod_color                AS color,
               vod_class                AS classes,
               vod_tag                  AS tag,
               vod_pic                  AS pic,
               vod_pic_thumb            AS picThumb,
               vod_pic_slide            AS picSlide,
               vod_actor                AS actor,
               vod_director             AS director,
               vod_writer               AS writer,
               vod_behind               AS behind,
               vod_blurb                AS blurb,
               vod_remarks              AS remarks,
               vod_pubdate              AS pubdate,
               vod_area                 AS area,
               vod_lang                 AS lang,
               vod_year                 AS year,
               vod_version              AS version,
               vod_state                AS state,
               vod_tv                   AS tv,
               vod_weekday              AS weekday,
               vod_duration             AS duration,
               vod_serial               AS serial,
               vod_total                AS total,
               vod_isend                AS isEnd,
               vod_level                AS level,
               vod_copyright            AS copyright,
               vod_score                AS score,
               vod_score_all            AS scoreAll,
               vod_score_num            AS scoreNum,
               vod_douban_id            AS doubanId,
               vod_douban_score         AS doubanScore,
               vod_hits                 AS hits,
               vod_hits_day             AS hitsDay,
               vod_hits_week            AS hitsWeek,
               vod_hits_month           AS hitsMonth,
               vod_up                   AS up,
               vod_down                 AS down,
               vod_time                 AS updatedAt,
               vod_time_add             AS addedAt,
               vod_content              AS content,
               (CHAR_LENGTH(vod_pwd) &gt; 0) AS detailPasswordRequired
        FROM mac_vod
        WHERE vod_id = #{id}
          AND vod_status = 1
    </select>

    <!--
      专题关联视频（MACC-27，application/common/model/Topic.php:291-301）：vod_id IN (topic_rel_vod) + vod_status=1，按 vod_time 倒序
      取前 999 条；新增分类可见性条件，追加 vod_id 倒序使并列时结果确定。
    -->
    <select id="selectPublishedByIds" resultType="com.maccms.backend.content.infrastructure.VodSummaryRow">
        SELECT /*+ MAX_EXECUTION_TIME(3000) */ <include refid="summaryColumns"/>
        FROM mac_vod
        WHERE <include refid="publishedInTypes"/>
          AND vod_id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY vod_time DESC, vod_id DESC
        LIMIT 999
    </select>

    <!-- 专题按标签关联视频（MACC-27，Topic.php:314-323）：vod_tag LIKE 任一模式（由 content.application 构造并以 '!' 转义）。 -->
    <select id="selectPublishedByTagPatterns" resultType="com.maccms.backend.content.infrastructure.VodSummaryRow">
        SELECT /*+ MAX_EXECUTION_TIME(3000) */ <include refid="summaryColumns"/>
        FROM mac_vod
        WHERE <include refid="publishedInTypes"/>
          AND (<foreach collection="patterns" item="p" separator=" OR ">vod_tag LIKE #{p} ESCAPE '!'</foreach>)
        ORDER BY vod_time DESC, vod_id DESC
        LIMIT 999
    </select>

    <!--
      角色所属视频（MACC-27）：旧 Role::listData/infoData 按 role_rid 取视频（application/common/model/Role.php:41-51、:296-303，
      不看 vod_status）；新版只取已审核的视频，分类可见性由 content.application 判定。
    -->
    <select id="selectPublishedRefs" resultType="com.maccms.backend.content.infrastructure.VodRefRow">
        SELECT vod_id   AS id,
               type_id  AS categoryId,
               vod_name AS name,
               vod_en   AS enName
        FROM mac_vod
        WHERE vod_status = 1
          AND vod_id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>

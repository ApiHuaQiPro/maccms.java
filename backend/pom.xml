<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 版本选择理由见 docs/architecture/01-batch1-content-read-plan.md 第 2 节 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.maccms</groupId>
    <artifactId>maccms-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>maccms-backend</name>
    <description>MacCMS 重构：Java 模块化单体（content 只读接口、site 服务端渲染骨架）</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-spring-boot.version>4.1.0</mybatis-spring-boot.version>
        <!--
          覆盖 Spring Boot 4.1.1 默认管理的 Connector/J 9.7.0：9.x 官方只支持 MySQL 8.0+，
          旧库是 MySQL 5.7（线上版本待核实）。8.2.0 是最后一个在发布说明中写明
          "can be used against MySQL Server version 5.7 and later" 的版本，且已修复 CVE-2023-22102。
        -->
        <mysql.version>8.2.0</mysql.version>
        <!--
          site 模板引擎（MACC-7 选型、用户确认 D2）：jte 固定 3.2.4，不受 Spring Boot 依赖管理。
          只用 jte-runtime + jte-models（预编译 + 类型安全入口），不引入 jte-spring-boot-starter-4。
        -->
        <jte.version>3.2.4</jte.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>gg.jte</groupId>
            <artifactId>jte-runtime</artifactId>
            <version>${jte.version}</version>
        </dependency>
        <!-- 生成的类型安全模板入口（Templates / StaticTemplates）依赖它 -->
        <dependency>
            <groupId>gg.jte</groupId>
            <artifactId>jte-models</artifactId>
            <version>${jte.version}</version>
        </dependency>

        <!--
          site 富文本白名单过滤（MACC-12，选型见 docs/architecture/07-rich-text-filter.md 第 2 节）：jsoup 固定 1.23.2，
          MIT 许可，Boot 不管理其版本，无运行时传递依赖（re2j 为 optional、jspecify 为 provided）。
          测试同时用它按 HTML 规则断言页面结构。site 只能用 nodes/parser/safety 包，禁止 Jsoup/Connection 等网络 API
          （ModuleBoundaryTest）。
        -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.23.2</version>
        </dependency>

        <!--
          二维码本地生成（B06，旧 index/controller/Qrcode.php 用 phpqrcode，docs/architecture/16-b06-misc-pages-provide.md 第 4.7 节）：
          ZXing core 固定 3.5.3，Apache-2.0，纯计算、无网络 API、无运行时传递依赖。只用 qrcode.encoder 生成矩阵，PNG 由 javax.imageio 输出；
          测试另用它的解码器核对与 phpqrcode 输出解码出同一文本。不使用 zxing javase 模块。
        -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>

        <!--
          WebP 头像解码（B09，MACC-23 队长裁定方案 B，docs/architecture/18-b09-member-account.md 第 14 节）：TwelveMonkeys
          imageio-webp 固定 3.12.0，BSD-3-Clause，纯 Java、无本地库。图片格式只多一个 WebP 读取器（没有写入器）；imageio-core 另经
          SPI 注册 ImageInputStreamSpi，PortraitImages 显式使用 MemoryCacheImageInputStream，不受其影响。传递依赖 imageio-core /
          imageio-metadata / common-lang / common-io / common-image 同为 3.12.0；许可、版权与 common-image 中 ASF 1.1 代码的致谢语
          随包放在 classpath:licenses/twelvemonkeys-imageio-3.12.0.txt。只有 member.application.PortraitImages 引用其类型（ModuleBoundaryTest）。
        -->
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <version>3.12.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 仅测试：用 jte 编译器以更严格的站点 HTML 策略重新编译全部正式模板（SiteTemplatePolicyTest） -->
        <dependency>
            <groupId>gg.jte</groupId>
            <artifactId>jte</artifactId>
            <version>${jte.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!--
              B05（docs/architecture/15-b05-readonly-pages.md 第 6.2 节）：旧前台播放器资源原样复用，不复制进 backend/：
              构建时把仓库 static/js/player.js、static/js/jquery.js（player.js 依赖 $）与 static/player/**（含 iva）放进
              classpath:/static/static/，由 Spring 的静态资源处理按旧路径 /static/js/player.js、/static/player/… 提供。
              static/js/playerconfig.js 不在其中：它由 Java 按旧配置生成（PlayerConfigController，W1 两态）。旧文件只读，不改动。
            -->
            <resource>
                <directory>${project.basedir}/../static</directory>
                <targetPath>static/static</targetPath>
                <includes>
                    <include>js/player.js</include>
                    <include>js/jquery.js</include>
                    <include>player/**</include>
                </includes>
            </resource>
            <!--
              B12（docs/architecture/21-b12-admin-framework.md 第 8 节）：旧后台的样式与脚本原样复用，同样不复制进 backend/：
              layui（含模块、字体与图片）、static/css/admin_style.css、static/js/admin_common.js（jquery.js 已在上面），
              按旧路径 /static/layui/…、/static/css/…、/static/js/… 提供。旧模板里的内联脚本改成 src/main/resources/static/admin-assets/ 下的文件。
            -->
            <resource>
                <directory>${project.basedir}/../static</directory>
                <targetPath>static/static</targetPath>
                <includes>
                    <include>layui/**</include>
                    <include>css/admin_style.css</include>
                    <include>js/admin_common.js</include>
                </includes>
            </resource>
            <!--
              B13（docs/architecture/22-b13-admin-content.md 第 4 节）：旧拼音字典 static/data/pinyin.dat 原样打进 jar 的
              legacy/data/（只供 LegacyPinyin 读取，不经静态资源对外提供）。旧文件只读，不改动。
            -->
            <resource>
                <directory>${project.basedir}/../static</directory>
                <targetPath>legacy</targetPath>
                <includes>
                    <include>data/pinyin.dat</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              site 模板预编译：src/main/jte 下的模板在 generate-sources 生成 Java 源码，与业务代码一起 javac，
              模板引用不存在的字段/方法、参数类型不符都会让 compile 失败（包括测试走不到的分支）。
              OwaspHtmlPolicy 在生成阶段拒绝未加引号的属性值、在标签名/属性名中输出等写法；
              更严格的站点策略（禁止事件属性、脚本块等）由 SiteTemplatePolicyTest 在 verify 中执行。
              运行时只加载生成的类，不编译模板，也不需要 JDK 编译器。
            -->
            <plugin>
                <groupId>gg.jte</groupId>
                <artifactId>jte-maven-plugin</artifactId>
                <version>${jte.version}</version>
                <configuration>
                    <sourceDirectory>${project.basedir}/src/main/jte</sourceDirectory>
                    <contentType>Html</contentType>
                    <htmlPolicyClass>gg.jte.html.OwaspHtmlPolicy</htmlPolicyClass>
                    <packageName>com.maccms.backend.site.web.jte</packageName>
                    <extensions>
                        <extension>
                            <className>gg.jte.models.generator.ModelExtension</className>
                        </extension>
                    </extensions>
                </configuration>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                    <!--
                      B12 后台模板（src/main/jte-admin，生成到 com.maccms.backend.admin.web.jte）：与站点模板分开编译、分开生成
                      Templates 入口，admin 模块不引用 site 的生成类；更严格的后台策略由 AdminTemplatePolicyTest 在 verify 中执行。
                    -->
                    <execution>
                        <id>jte-admin</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/main/jte-admin</sourceDirectory>
                            <targetDirectory>${project.build.directory}/generated-sources/jte-admin</targetDirectory>
                            <packageName>com.maccms.backend.admin.web.jte</packageName>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>gg.jte</groupId>
                        <artifactId>jte-models</artifactId>
                        <version>${jte.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 默认构建只跑单元与 HTTP 契约测试（*Test），不连数据库 -->
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          MySQL 集成测试：./mvnw verify -Pmysql-it
          需要外部环境变量 MACCMS_IT_ADMIN_URL / MACCMS_IT_ADMIN_USERNAME / MACCMS_IT_ADMIN_PASSWORD，
          测试会新建一次性库 maccms_it_<随机后缀>，结束后只删除该库。说明见 backend/README.md。
        -->
        <profile>
            <id>mysql-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

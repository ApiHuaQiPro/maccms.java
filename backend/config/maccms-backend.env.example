# maccms-backend 运行配置样例。复制为 config/local.env（已被 .gitignore 忽略）后填写，切勿提交真实值。
# 应用只从环境变量读取数据库配置；缺少 MACCMS_DB_URL / MACCMS_DB_USERNAME / MACCMS_DB_PASSWORD 时拒绝启动。

# 旧 MacCMS 库（mac_* 表）的 JDBC 地址。只需要该库的 SELECT 权限。
MACCMS_DB_URL=jdbc:mysql://127.0.0.1:3306/<库名>?characterEncoding=UTF-8&useSSL=false
# 专用只读账号（仅授予 SELECT），由数据库管理员另行创建，见 backend/README.md「数据库账号」。
MACCMS_DB_USERNAME=<只读账号>
MACCMS_DB_PASSWORD=<密码>
# 仅本机开发、确实没有只读账号时才设为 true（允许 root；连接本身仍是只读会话）
MACCMS_DB_ALLOW_ROOT=false
# 连接池大小（默认 10）
MACCMS_DB_POOL_SIZE=10

# 可写数据源（B07，docs/architecture/12-write-infrastructure.md 第 2 节）。默认 false：不创建任何可写连接，应用只读。
# 已登记的业务写入：B09 会员账号（mac_user）。开发期只在一次性库 maccms_it_* 上打开；不要指向 maccms_dev、共享库或线上库。
# 关闭时会员入口 user/* 返回 503（页面上的会员登录态仍只读判定）。
# 打开时下面三项都必须单独填写（不沿用 MACCMS_DB_*）；地址须与 MACCMS_DB_URL 同主机、端口、库名，不能带 useAffectedRows、
# allowMultiQueries、allowLoadLocalInfile、sessionVariables、user、password 参数（由应用固定）。
MACCMS_WRITE_ENABLED=false
MACCMS_WRITE_DB_URL=
# 专用写账号（只授予 mac_* 表的 SELECT/INSERT/UPDATE/DELETE），由数据库管理员另行创建
MACCMS_WRITE_DB_USERNAME=
MACCMS_WRITE_DB_PASSWORD=
# 仅本机开发确需 root 时设为 true
MACCMS_WRITE_DB_ALLOW_ROOT=false
# 可写连接池大小（1～50，默认 4）
MACCMS_WRITE_DB_POOL_SIZE=4

# 会员头像目录（B09）：旧站根目录下 upload/ 的本地路径，头像写到其下 user/<id%10>/<id>.jpg（由 nginx 直接提供）；留空时头像上传不可用
MACCMS_MEMBER_UPLOAD_DIR=

# 后台上传与附件目录（B13）：同一个旧站 upload/ 的本地路径；只存本地，留空时后台上传、附件浏览与内容图片删除不可用
MACCMS_UPLOAD_DIR=

# 监听地址与端口（默认 127.0.0.1:18280；本机 8080/18080 已被占用）
MACCMS_SERVER_ADDRESS=127.0.0.1
MACCMS_SERVER_PORT=18280

# 与旧 PHP 配置对齐的行为开关（线上取值待核实，默认取更严格的一侧）：
# 对应 maccms.php 的 user.status：1 时按游客组权限判定分类/详情可见性
MACCMS_CONTENT_ENFORCE_GUEST_POPEDOM=true
# 对应 maccms.php 的 app.copyright_status=2：版权视频不提供详情
MACCMS_CONTENT_COPYRIGHT_HIDES_DETAIL=true
# 对应 maccms.php 的 user.art_points_type（B05）：1 按 art_points 整篇收费，0 按 art_points_detail 按页收费；留空按仓库值 1
MACCMS_CONTENT_ART_POINTS_TYPE=1
# 视频搜索（契约 1.1.0）：是否接受包含匹配参数 keyword、classes。默认 false；开启前须完成合成库性能测量并经确认
# （docs/architecture/09-content-search-filter-plan.md 第 6.5 节）。area/lang/year/level 精确筛选不受此开关影响。
MACCMS_CONTENT_SEARCH_ENABLED=false
# 带 keyword/classes 的请求同时执行的上限，1 到 MACCMS_DB_POOL_SIZE-1，超过即 503（不排队）
MACCMS_CONTENT_SEARCH_MAX_CONCURRENT=4

# site 服务端页面（MACC-9 骨架，见 docs/architecture/05-site-skeleton.md）。默认关闭；关闭时不注册任何页面路由。
# 启用后 MACCMS_SITE_NAME、MACCMS_SITE_BASE_URL 必填，缺失或不合法时拒绝启动。下面是本地合成值，不是线上配置。
# 设置了 MACCMS_LEGACY_CONFIG_DIR 时，下面除 BASE_URL、CANONICAL_REDIRECT、HIT_COUNTER_ENABLED、SEARCH_ENABLED 以外的站点项
# 留空即取旧配置 extra/maccms.php 的对应值（非空的环境变量优先），站名也可以来自旧 site_name；启动时读一次，改了要重启。
MACCMS_SITE_ENABLED=false
MACCMS_SITE_NAME=MacCMS 本地站（合成）
# http/https 绝对地址，路径以 / 结尾，不含用户信息、查询串、片段；canonical 只用它，不读 Host 头。
# .test 是保留顶级域名，不会解析到真实站点。
MACCMS_SITE_BASE_URL=http://maccms.local.test/
MACCMS_SITE_KEYWORDS=
MACCMS_SITE_DESCRIPTION=
MACCMS_SITE_ICP=
# 留空，或 http/https 绝对地址，或以单个 / 开头的站内路径
MACCMS_SITE_LOGO_URL=
# open / closed；closed 时所有 site 页面返回 503 维护页（不查库），content API 不受影响。留空取旧 site_status，没有旧配置按 open
MACCMS_SITE_STATUS=
# 维护页文案（留空用默认文案）
MACCMS_SITE_CLOSED_MESSAGE=
# canonical 301（D4）与点击计数（D5）尚未批准，只能为 false
MACCMS_SITE_CANONICAL_REDIRECT=false
MACCMS_SITE_HIT_COUNTER_ENABLED=false
# SSR 搜索页（MACC-20）：true/false，默认 false（关闭时 /index.php/vod/search… 路由不存在）。需同时开启 MACCMS_SITE_ENABLED。
# 关键字与扩展分类仍受 MACCMS_CONTENT_SEARCH_ENABLED 控制；T2 测量（MACC-19）建议包含匹配保持关闭。
MACCMS_SITE_SEARCH_ENABLED=false
# 旧站 URL 形态（MACC-14，对应旧 rewrite.status / rewrite.suffix_hide，线上取值待核实）：true/false。
# rewrite=true 时生成的地址不含 index.php；suffix-hide=true 时 .html 换成 /。分隔符固定 /，不启用路由别名。
# 留空取旧 rewrite.status / rewrite.suffix_hide，没有旧配置按 false。
MACCMS_SITE_URL_REWRITE=
MACCMS_SITE_URL_SUFFIX_HIDE=
# 图片地址（MACC-14，对应旧 upload.*，线上取值待核实）。protocol 留空按 http；mode=remote 时相对路径拼 remote-url。
# img-key 留空不启用；启用时只接受字面域名多选一（如 img\.a\.test|img\.b\.test），命中的地址前面拼 img-api。
MACCMS_SITE_IMAGE_PROTOCOL=
MACCMS_SITE_IMAGE_MODE=
MACCMS_SITE_IMAGE_REMOTE_URL=
MACCMS_SITE_IMAGE_IMG_KEY=
MACCMS_SITE_IMAGE_IMG_API=

# 旧配置只读层（B02，docs/architecture/11-guards-and-legacy-config.md）：旧站 application 目录（含 extra/*.php、route.php）。
# 留空表示未配置（站点设置只用环境变量）。只读解析 var_export 格式，不执行 PHP、不写回。只指向本地副本，不要指向线上目录或 prod-config。
MACCMS_LEGACY_CONFIG_DIR=
# 浏览器侧外部地址放行（B02，路线图第 1.3、4.2 节）：部署级参数。按路线图第五轮，W1/W2 按旧版放行、默认 true，
# 设为 false 是部署方可选的关闭态（关闭时页面不输出外部主机地址）；W3 随支付批次 B24 放行，在此之前只能为 false。
# W1 播放器解析与外部脚本（输出在 B05 实现）；W2 外链图片与外部播放/下载地址；W3 支付网关跳转。
MACCMS_BROWSER_EXTERNAL_W1=true
MACCMS_BROWSER_EXTERNAL_W2=true
MACCMS_BROWSER_EXTERNAL_W3=false

# 出站客户端（B23，docs/architecture/26-b23-integration-foundation.md 第 3 节）：部署级参数。integration 已登记子包（B24～B29）的
# HTTP 请求都经过它；B23 本身不登记任何子包，不发任何请求。MODE 为 open（默认）或 loopback-only（只允许回环地址，测试与本机模拟服务用）。
# 超时与旧 mac_curl_* 相同（连接 15s、整体 30s）。第三方密钥只在 MACCMS_LEGACY_CONFIG_DIR 指向的旧配置里，不要写进这里。
MACCMS_INTEGRATION_OUTBOUND_MODE=open
MACCMS_INTEGRATION_OUTBOUND_CONNECT_TIMEOUT=15s
MACCMS_INTEGRATION_OUTBOUND_READ_TIMEOUT=30s
MACCMS_INTEGRATION_OUTBOUND_MAX_RESPONSE_BYTES=4194304

# 客户端 IP（B06，D2 ④，docs/architecture/16-b06-misc-pages-provide.md 第 2 节）：部署级参数。默认不信任任何代理，客户端 IP 就是连接对端，
# CF-Connecting-IP、X-Real-IP、X-Forwarded-For 等请求头一律不看。部署在 CDN/反向代理后面时，填写代理出口的 IP 或 CIDR（逗号分隔，
# 最多 64 项），只有对端落在其中时才采用 MACCMS_CLIENT_IP_HEADER 指定的头（留空为 X-Forwarded-For，按从右往左跳过可信代理；
# 也可设为单值头 X-Real-IP、CF-Connecting-IP、True-Client-IP、Ali-CDN-Real-IP）。代理必须自己追加或覆盖该头（nginx：
# proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for）；头给不出客户端时客户端 IP 为 0.0.0.0（白名单拒绝），不退回代理地址。不要填 0.0.0.0/0 之类的宽网段：任何人都能伪造转发头。
# 未填写时，经代理到达的请求的客户端 IP 全部是代理地址（Provide 白名单只能按代理地址判断）。
MACCMS_TRUSTED_PROXIES=
MACCMS_CLIENT_IP_HEADER=
# Provide 资源站接口（B06，16 文档第 3 节，/api.php/provide/**）：true/false，默认 false（关闭时不注册路由）。
# 打开后各模块按旧配置 api.<模块>.status 判定（需要 MACCMS_LEGACY_CONFIG_DIR；未设置时全部输出 closed），charge=1 的白名单按上面的
# 客户端 IP 判定；datafilter 只接受"<列> <运算符> <整数>"的 AND 组合（不执行配置中的 SQL），其他写法启动失败。只读，不写点击计数。
MACCMS_OPENAPI_ENABLED=false
# 后台（B12，docs/architecture/21-b12-admin-framework.md 第 7 节）：true/false，默认 false（关闭时没有任何后台路由）。
# 启用时必须打开上面的可写数据源；ENTRY 为后台入口文件路径（形如 /_admin.php，不能是 /admin.php、/index.php、/api.php、/install.php），
# BASE_URL 为对外地址（同 MACCMS_SITE_BASE_URL 的写法），缺失或不合法时拒绝启动。登录验证码、每页条数、语言取旧配置 extra/maccms.php。
MACCMS_ADMIN_ENABLED=false
MACCMS_ADMIN_ENTRY=/_admin.php
MACCMS_ADMIN_BASE_URL=http://maccms.local.test/

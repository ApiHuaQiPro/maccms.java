# maccms-backend 运行配置样例。复制为 config/local.env（已被 .gitignore 忽略）后填写，切勿提交真实值。
# 应用只从环境变量读取数据库配置；缺少 MACCMS_DB_URL / MACCMS_DB_USERNAME / MACCMS_DB_PASSWORD 时拒绝启动。

# 旧 MacCMS 库（mac_* 表）的 JDBC 地址。只需要该库的 SELECT 权限。
MACCMS_DB_URL=jdbc:mysql://127.0.0.1:3306/<库名>?characterEncoding=UTF-8&useSSL=false
# 专用只读账号（仅授予 SELECT），由数据库管理员另行创建，见 backend/README.md「数据库账号」。
MACCMS_DB_USERNAME=<只读账号>
MACCMS_DB_PASSWORD=<密码>
# 仅本机开发、确实没有只读账号时才设为 true（允许 root；连接本身仍是只读会话）
MACCMS_DB_ALLOW_ROOT=false
# 连接池大小（默认 10）
MACCMS_DB_POOL_SIZE=10

# 监听地址与端口（默认 127.0.0.1:18280；本机 8080/18080 已被占用）
MACCMS_SERVER_ADDRESS=127.0.0.1
MACCMS_SERVER_PORT=18280

# 与旧 PHP 配置对齐的行为开关（线上取值待核实，默认取更严格的一侧）：
# 对应 maccms.php 的 user.status：1 时按游客组权限判定分类/详情可见性
MACCMS_CONTENT_ENFORCE_GUEST_POPEDOM=true
# 对应 maccms.php 的 app.copyright_status=2：版权视频不提供详情
MACCMS_CONTENT_COPYRIGHT_HIDES_DETAIL=true
# 视频搜索（契约 1.1.0）：是否接受包含匹配参数 keyword、classes。默认 false；开启前须完成合成库性能测量并经确认
# （docs/architecture/09-content-search-filter-plan.md 第 6.5 节）。area/lang/year/level 精确筛选不受此开关影响。
MACCMS_CONTENT_SEARCH_ENABLED=false
# 带 keyword/classes 的请求同时执行的上限，1 到 MACCMS_DB_POOL_SIZE-1，超过即 503（不排队）
MACCMS_CONTENT_SEARCH_MAX_CONCURRENT=4

# site 服务端页面（MACC-9 骨架，见 docs/architecture/05-site-skeleton.md）。默认关闭；关闭时不注册任何页面路由。
# 启用后 MACCMS_SITE_NAME、MACCMS_SITE_BASE_URL 必填，缺失或不合法时拒绝启动。下面是本地合成值，不是线上配置。
MACCMS_SITE_ENABLED=false
MACCMS_SITE_NAME=MacCMS 本地站（合成）
# http/https 绝对地址，路径以 / 结尾，不含用户信息、查询串、片段；canonical 只用它，不读 Host 头。
# .test 是保留顶级域名，不会解析到真实站点。
MACCMS_SITE_BASE_URL=http://maccms.local.test/
MACCMS_SITE_KEYWORDS=
MACCMS_SITE_DESCRIPTION=
MACCMS_SITE_ICP=
# 留空，或 http/https 绝对地址，或以单个 / 开头的站内路径
MACCMS_SITE_LOGO_URL=
# open / closed；closed 时所有 site 页面返回 503 维护页（不查库），content API 不受影响
MACCMS_SITE_STATUS=open
# 维护页文案（留空用默认文案）
MACCMS_SITE_CLOSED_MESSAGE=
# canonical 301（D4）与点击计数（D5）尚未批准，只能为 false
MACCMS_SITE_CANONICAL_REDIRECT=false
MACCMS_SITE_HIT_COUNTER_ENABLED=false
# SSR 搜索页（MACC-20）：true/false，默认 false（关闭时 /index.php/vod/search… 路由不存在）。需同时开启 MACCMS_SITE_ENABLED。
# 关键字与扩展分类仍受 MACCMS_CONTENT_SEARCH_ENABLED 控制；T2 测量（MACC-19）建议包含匹配保持关闭。
MACCMS_SITE_SEARCH_ENABLED=false
# 旧站 URL 形态（MACC-14，对应旧 rewrite.status / rewrite.suffix_hide，线上取值待核实）：true/false。
# rewrite=true 时生成的地址不含 index.php；suffix-hide=true 时 .html 换成 /。分隔符固定 /，不启用路由别名。
MACCMS_SITE_URL_REWRITE=false
MACCMS_SITE_URL_SUFFIX_HIDE=false
# 图片地址（MACC-14，对应旧 upload.*，线上取值待核实）。protocol 留空按 http；mode=remote 时相对路径拼 remote-url。
# img-key 留空不启用；启用时只接受字面域名多选一（如 img\.a\.test|img\.b\.test），命中的地址前面拼 img-api。
MACCMS_SITE_IMAGE_PROTOCOL=
MACCMS_SITE_IMAGE_MODE=
MACCMS_SITE_IMAGE_REMOTE_URL=
MACCMS_SITE_IMAGE_IMG_KEY=
MACCMS_SITE_IMAGE_IMG_API=

    <!-- Group::delData（common/model/Group.php:88-100）：旧版先数该组下的会员、没有才删；新版删除时再按条件排除仍有会员的组（两步之间被分配了
         会员时不删，MyISAM 整句持两张表的锁） -->
    <delete id="deleteEmptyGroups">
        DELETE FROM mac_group
        WHERE group_id IN <foreach collection="ids" item="i" open="(" separator="," close=")">#{i}</foreach>
          AND NOT EXISTS (SELECT 1 FROM mac_user AS u WHERE u.group_id = mac_group.group_id)
    </delete>

    <!-- mac_card：Card::saveAllData（common/model/Card.php:80-96）的 insertAll，一批一条多行 INSERT -->
    <insert id="insertCards">
        INSERT INTO mac_card (card_no, card_pwd, card_money, card_points, card_add_time) VALUES
        <foreach collection="rows" item="r" separator=",">(#{r.no}, #{r.pwd}, #{money}, #{points}, #{now})</foreach>
    </insert>

    <delete id="deleteCards">
        DELETE FROM mac_card WHERE card_id IN <foreach collection="ids" item="i" open="(" separator="," close=")">#{i}</foreach>
    </delete>

    <!-- 旧"清空"（Card::del 的 all=1：card_id > 0 即全部；以下各表同） -->
    <delete id="deleteAllCards">
        DELETE FROM mac_card WHERE card_id &gt; 0
    </delete>

    <!-- mac_order：Order::del -->
    <delete id="deleteOrders">
        DELETE FROM mac_order WHERE order_id IN <foreach collection="ids" item="i" open="(" separator="," close=")">#{i}</foreach>
    </delete>

    <delete id="deleteAllOrders">
        DELETE FROM mac_order WHERE order_id &gt; 0
    </delete>

    <!-- mac_cash：Cash::auditData（common/model/Cash.php:165-187）逐行"标为已审核 → 扣冻结积分"改为条件写入：未审核才认领 -->
    <update id="auditCash">
        UPDATE mac_cash
        SET cash_status = 1, cash_time_audit = #{now}
        WHERE cash_id = #{cashId} AND cash_status = 0
    </update>

    <!-- 审核的补偿（扣冻结积分不命中时）：仍是本次写入的值才恢复 -->
    <update id="revertAudit">
        UPDATE mac_cash
        SET cash_status = 0, cash_time_audit = #{oldAudit}
        WHERE cash_id = #{cashId} AND cash_status = 1 AND cash_time_audit = #{now}
    </update>

    <!-- 旧 setDec('user_points_froze', cash_points)：冻结积分足够才命中（旧版不检查，扣成负数时 MySQL 报错） -->
    <update id="settleFrozen">
        UPDATE mac_user
        SET user_points_froze = user_points_froze - #{points}
        WHERE user_id = #{userId} AND user_points_froze &gt;= #{points}
    </update>

    <!-- mac_plog / mac_ulog / mac_visit：Plog::del、Ulog::del、Visit::del -->
    <delete id="deletePlogs">
        DELETE FROM mac_plog WHERE plog_id IN <foreach collection="ids" item="i" open="(" separator="," close=")">#{i}</foreach>
    </delete>

    <delete id="deleteAllPlogs">
        DELETE FROM mac_plog WHERE plog_id &gt; 0
    </delete>

    <delete id="deleteUlogs">
        DELETE FROM mac_ulog WHERE ulog_id IN <foreach collection="ids" item="i" open="(" separator="," close=")">#{i}</foreach>
    </delete>

    <delete id="deleteAllUlogs">
        DELETE FROM mac_ulog WHERE ulog_id &gt; 0
    </delete>

    <delete id="deleteVisits">
        DELETE FROM mac_visit WHERE visit_id IN <foreach collection="ids" item="i" open="(" separator="," close=")">#{i}</foreach>
    </delete>

    <delete id="deleteAllVisits">

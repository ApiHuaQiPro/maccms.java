{
  "meta": {
    "description": "mac_url_img（application/common.php:1633-1657）黄金向量。php 为旧函数的真实输出，expect 为新版 site.application.ImageUrlNormalizer 的结果。全部为合成值：域名使用保留的 .test 顶级域，不含线上域名、密钥或 URL；线上 upload 配置未知，向量不代表生产行为。",
    "verification": "php 与 php_warning 由同目录 mac_url_img_golden.php 从 application/common.php 原样取出 mac_url_img 与 mac_filter_xss 后执行得到，并用该脚本复核（PHP 7.2.34、7.3.33、8.0.30、8.2.32 结果一致）。Java 侧由 ImageUrlGoldenVectorsTest 读取本文件，逐条断言 branch、expect 与 compat。",
    "compat_rules": {
      "SAME": "新版 href 等于浏览器从旧输出得到的地址：按 HTML 属性规则解码字符引用，再把空格编码为 %20",
      "PROTOCOL_RELATIVE_COMPLETED": "旧输出解码后是协议相对地址（//host/…），新版 href = base-url 的协议 + \":\" + 该地址",
      "REJECTED": "新版不输出地址（页面显示占位图）；note 写明旧版的结果",
      "CONFIG_REJECTED": "新版在创建规范化器时拒绝该配置（启动失败），只报配置项名称，不回显取值"
    },
    "outcomes": {
      "ACCEPTED": "得到 SafeUrl",
      "EMPTY": "空值或只有空白",
      "TAG_LIKE": "含 <（旧版 strip_tags 会改写，不模拟）",
      "UNSUPPORTED_CHAR_REF": "含浏览器可能解码、但新版不支持的字符引用",
      "NOT_ALLOWED": "结果不在 SafeUrl 白名单内",
      "CONFIG_ERROR": "配置不合法"
    }
  },
